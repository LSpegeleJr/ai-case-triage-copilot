# Copy this file to .env (never committed) and fill in your own real values.

ANTHROPIC_API_KEY=your-anthropic-api-key

# Salesforce Dev org credentials, from your Dev org's own External Client App
# (OAuth 2.0 Client Credentials flow) — see BUILD_GUIDE.md, Sprint 1.
SF_INSTANCE_URL=https://your-dev-domain.my.salesforce.com
SF_CONSUMER_KEY=your-dev-consumer-key
SF_CONSUMER_SECRET=your-dev-consumer-secret
