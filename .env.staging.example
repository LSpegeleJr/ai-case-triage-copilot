# Staging org credentials — same shape as .env.example, filled in with
# Staging's own values instead of Dev's. Copy this to a real ".env.staging"
# (never committed, just like .env itself) and fill in the real values from
# Staging's own External Client App — these are NOT the same values as
# Dev's, since OAuth credentials are per-org, not shared across orgs.

SF_INSTANCE_URL=https://your-staging-domain.my.salesforce.com
SF_CONSUMER_KEY=your-staging-consumer-key
SF_CONSUMER_SECRET=your-staging-consumer-secret
